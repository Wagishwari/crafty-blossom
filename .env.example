# Server-only configuration. Never put service-role or payment secrets in NEXT_PUBLIC_*.
# Next.js: copy to .env.local. Existing Worker preview: copy to .dev.vars.
STORE_MODE=preview
PUBLIC_SITE_URL=http://127.0.0.1:3001
SUPABASE_URL=https://zhdxbabfoogvennmrwuv.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Generate independent cryptographically random secrets of at least 32 characters.
CHECKOUT_TOKEN_SECRET=
CRON_SECRET=
# Start with a Razorpay TEST account. Keep live permission disabled.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
ALLOW_LIVE_PAYMENTS=false
# Resend requires a verified sender domain/address.
RESEND_API_KEY=
RESEND_FROM=
# Enable only after approved privacy information and hosted database checks.
ACCEPT_ENQUIRIES=false
LAUNCH_VALIDATED=false
